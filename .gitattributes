# Normalize all text files to LF in repo, convert to CRLF on checkout in Windows
* text=auto eol=lf

# Force specific types (optional)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.cs    text eol=lf
*.csproj text eol=lf
*.sln   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
